# Secret-free reference only. server.js does not load this file automatically.
# Copy values into the process environment or a local untracked environment file.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
DATA_DIR=./runtime-data
BACKUP_ROOT=./runtime-data/backups
FORMULA_BACKUP_DIR=./runtime-data/formula-backups
ELEC_TMP_DIR=./runtime-data/tmp/gokotta-elec
ADMIN_USERNAME=Larkix
# Replace before use with a unique random value of at least 32 characters.
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
ADMIN_RESET_PASSWORD_ON_START=false
# Set before use to a unique random URL-safe value of 48-128 characters.
# Production startup intentionally fails while this remains empty.
PRIVATE_CMS_PATH=
# true is allowed only for an isolated HTTP loopback test.
ALLOW_INSECURE_PRIVATE_CMS_LOOPBACK=false
ALLOW_HARD_DELETE=false
MAX_BACKUP_AGE_HOURS=26
OFFSITE_BACKUP_TARGET=
OFFSITE_BACKUP_MODE=rsync
SITE_URL=http://127.0.0.1:4173
