NODE_ENV=production
DATA_DIR=/srv/gokottamaker-data
BACKUP_ROOT=/srv/gokottamaker-backups
ADMIN_USERNAME=Larkix
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_RESET_PASSWORD_ON_START=false
ALLOW_HARD_DELETE=false
MAX_BACKUP_AGE_HOURS=26
# Example: user@backup-host:/srv/gokottamaker-backups
OFFSITE_BACKUP_TARGET=
# rsync or rclone
OFFSITE_BACKUP_MODE=rsync
PORT=4173
HOST=127.0.0.1
SITE_URL=https://www.larkix.com
