# Secret-free systemd template. Install as /etc/gokottamaker.env with mode 600.
NODE_ENV=production
DATA_DIR=/srv/gokottamaker-data
BACKUP_ROOT=/srv/gokottamaker-backups
FORMULA_BACKUP_DIR=/srv/gokottamaker-data/formula-backups
ELEC_TMP_DIR=/srv/gokottamaker-data/tmp/gokotta-elec
ADMIN_USERNAME=Larkix
# Replace before installation; never commit the generated value.
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
ADMIN_RESET_PASSWORD_ON_START=false
# Set to one unique random URL-safe value of 48-128 characters.
# Production startup intentionally fails while this remains empty.
PRIVATE_CMS_PATH=
ALLOW_INSECURE_PRIVATE_CMS_LOOPBACK=false
ALLOW_HARD_DELETE=false
MAX_BACKUP_AGE_HOURS=26
# Example only: backup-user@backup-host:/srv/gokottamaker-backups
OFFSITE_BACKUP_TARGET=
# rsync or rclone
OFFSITE_BACKUP_MODE=rsync
# Content-package sync remains dry-run unless one maintenance command supplies
# the apply confirmation. Do not persist an apply confirmation here.
CONTENT_SYNC_PACKAGE=
CONTENT_SYNC_CHECKSUM=
CONTENT_SYNC_APPLY=false
CONTENT_SYNC_CONFIRM=
CONTENT_SYNC_MAX_BACKUP_AGE_HOURS=2
PORT=4173
HOST=127.0.0.1
SITE_URL=https://www.larkix.com
