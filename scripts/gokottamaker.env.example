NODE_ENV=production
DATA_DIR=/srv/gokottamaker-data
BACKUP_ROOT=/srv/gokottamaker-backups
ADMIN_USERNAME=Larkix
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_RESET_PASSWORD_ON_START=false
ALLOW_HARD_DELETE=false
MAX_BACKUP_AGE_HOURS=26
# Example: user@backup-host:/srv/gokottamaker-backups
OFFSITE_BACKUP_TARGET=
# rsync or rclone
OFFSITE_BACKUP_MODE=rsync
# 内容包同步默认只做 dry-run。正式 apply 只允许在单次维护命令中临时覆盖，
# 不要把 APPLY_CONTENT_SYNC 长期保存在生产环境文件中。
CONTENT_SYNC_PACKAGE=
CONTENT_SYNC_CHECKSUM=
CONTENT_SYNC_APPLY=false
CONTENT_SYNC_CONFIRM=
CONTENT_SYNC_MAX_BACKUP_AGE_HOURS=2
PORT=4173
HOST=127.0.0.1
SITE_URL=https://www.larkix.com
