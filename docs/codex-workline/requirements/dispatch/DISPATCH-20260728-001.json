  "decisions": [
    {
      "id": "decision.formula-critical-path",
      "statement": "REQ-20260728-003 establishes the final formula publication model before REQ-20260728-005 branching relations, REQ-20260728-008 drawer work, and REQ-20260728-004 migration."
    },
    {
      "id": "decision.single-writer-hot-files",
      "statement": "Tasks that edit server.js, lib/content.js, admin/index.html, admin/admin.js, admin/admin.css, post.js, derive.html, data/markdown-renderer.js, or styles/20-content.css are serialized whenever their write sets overlap."
    },
    {
      "id": "decision.parallel-only-disjoint",
      "statement": "Article reading time and inline math layout may run in parallel only after cover-crop semantics are accepted because their declared write sets are disjoint; browser acceptance remains serialized."
    },
    {
      "id": "decision.reserve-migration-numbers",
      "statement": "Reserve migration 020 for formula publication, 021 and 022 for branching derivations and revision presentation snapshots, 023 for legacy migration support, 024 for post cover coordinates, and 025 for nullable reading minutes."
    },
    {
      "id": "decision.destructive-split",
      "statement": "REQ-20260728-004 is split into isolated migration and cleanup proof first, followed by a separately authorized current or production cleanup operation. No numbered startup migration may physically delete legacy records."
    },
    {
      "id": "decision.theme-last",
      "statement": "The full-site dark-theme repair runs after all new formula, graph, drawer, media, and math surfaces exist so one final theme matrix covers the completed UI."
    }
  ],
