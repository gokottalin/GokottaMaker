  "decisions": [
    {
      "id": "decision.keep-a14-next",
      "statement": "A14 remains the only next task and is narrowed to formula catalog foundation; complete derivation chains move to A21."
    },
    {
      "id": "decision.split-req003",
      "statement": "REQ-20260726-003 is split between S09 catalog foundation and S13 article formula authoring so data/API and editor behavior are independently testable."
    },
    {
      "id": "decision.serialize-shared-files",
      "statement": "S09, S13, S14, S15, S16, and S17 execute serially because they share server.js, admin/admin.js, and persistence boundaries."
    },
    {
      "id": "decision.focus-scope-alias",
      "statement": "The canonical focus module is electronics-basics; existing power-electronics routes and metadata are accepted aliases. This does not create or delete a business category."
    },
    {
      "id": "decision.server-enforced-focus",
      "statement": "Focus visibility is enforced by server public payloads and direct-detail lookup, not by navigation hiding alone."
    },
    {
      "id": "decision.preserve-state",
      "statement": "Focus and carousel transitions must not delete content or alter draft/published state; formula history and article-bound versions remain immutable and readable."
    }
  ],
