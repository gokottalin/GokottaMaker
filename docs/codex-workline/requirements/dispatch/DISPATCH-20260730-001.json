  "decisions": [
    {
      "id": "decision.shared-math-first",
      "statement": "REQ-20260730-003 establishes one fixed shared math renderer and diagnostics contract before formula binding, MD2File parity, derivation recovery, or graph layout."
    },
    {
      "id": "decision.formula-critical-path",
      "statement": "Formula work is serialized as binding marker, selected-formula atomic creation, derivation workflow recovery, then left-to-right graph layout because these tasks share Markdown, CMS, API, and relation contracts."
    },
    {
      "id": "decision.carousel-authority-before-main",
      "statement": "REQ-20260730-001 and REQ-20260730-010 share carousel, focus, server, main.js, and CMS ownership and therefore execute in one workbench before focused cover or MD2File public entry changes."
    },
    {
      "id": "decision.parallel-only-disjoint",
      "statement": "S30 and S31 may run in parallel. After acceptance, focused cover, binding marker, and MD2File renderer parity may run in parallel only with their declared disjoint write sets."
    },
    {
      "id": "decision.migration-reservations",
      "statement": "Reserve migration 026 for authoritative Hero slots and 027 for append-only formula relation repair evidence; old migrations remain immutable."
    },
    {
      "id": "decision.no-destructive-apply",
      "statement": "Legacy relation work is limited to isolated fixtures, append-only repair evidence, and zero-deletion migration proof. Current/production mutation and physical cleanup remain separately blocked."
    },
    {
      "id": "decision.protected-paths",
      "statement": "styles/20-content.css, lib/seo.js, and historical docs/Agent* remain outside this batch write sets; later-loaded overrides and scoped public projections must be used."
    }
  ],
