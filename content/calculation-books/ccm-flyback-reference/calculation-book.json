      "symbol": "I.peak / I.valley",
      "parentFormulaId": "eq.i-peak",
      "prerequisites": ["稳态反激开关状态", "电感伏秒平衡", "输入功率平衡", "线性磁化电感"],
      "assumptions": ["assumption.vin-low-line", "assumption.efficiency", "assumption.equal-efficiency"],
      "validity": "固定频率稳态 CCM；磁化电感近似线性；忽略器件压降；I.valley 必须大于零。",
      "steps": [
        { "id": "step.ccm-vs-balance", "statement": "一个周期磁化电感的净伏秒为零。", "expression": "V.in·D = V.or·(1-D)", "justification": "稳态时每周期磁化电流回到相同起点。", "trace": { "kind": "identity", "refs": [], "note": "电感周期稳态伏秒平衡。" } },
        { "id": "step.ccm-duty", "statement": "解伏秒平衡得到占空比。", "expression": "D = V.or / (V.in+V.or)", "justification": "将 D 的项移到方程同一侧并除以 V.in+V.or。", "trace": { "kind": "identity", "refs": [], "note": "代数变形。" } },
        { "id": "step.ccm-ripple", "statement": "导通区间的磁化电流增量由电感本构关系积分。", "expression": "ΔI = ∫(V.in/L.m)dt = V.in·D/(L.m·f.sw)", "justification": "导通时间为 D/f.sw，且该区间电感电压近似恒定。", "trace": { "kind": "identity", "refs": [], "note": "V=L·di/dt 的定电压积分。" } },
        { "id": "step.ccm-input-current", "statement": "整周期输入平均电流由输入功率得到。", "expression": "I.inavg = P.out/(η·V.in)", "justification": "P.in=P.out/η 且直流输入 P.in=V.in·I.inavg。", "trace": { "kind": "identity", "refs": [], "note": "功率与效率定义。" } },
        { "id": "step.ccm-on-average", "statement": "输入只在原边开关导通期间提供磁化电流。", "expression": "I.inavg = D·I.onavg ⇒ I.onavg=I.inavg/D", "justification": "关断期间原边输入电流理想为零。", "trace": { "kind": "identity", "refs": [], "note": "分段波形的周期平均。" } },
        { "id": "step.ccm-peak-valley", "statement": "线性斜坡的平均值是峰谷中点。", "expression": "I.valley=I.onavg-ΔI/2；I.peak=I.onavg+ΔI/2", "justification": "导通电流从谷值线性上升到峰值。", "trace": { "kind": "identity", "refs": [], "note": "线性函数区间平均值。" } },
        { "id": "step.ccm-mode-check", "statement": "最终用谷值判定公式适用模式。", "expression": "I.valley>0 ⇒ CCM；I.valley=0 ⇒ BCM", "justification": "CCM 的定义是磁化电流在周期边界不回到零。", "trace": { "kind": "identity", "refs": [], "note": "工作模式定义。" } }
      ],
      "dimensionalCheck": "D 为 1；ΔI 的量纲 V·s/H=A；P/(V·D) 的量纲 A，因此 I.valley 与 I.peak 均为 A。",
