      "steps": [
        { "id": "step.rms-definition", "statement": "从整周期 RMS 定义出发。", "expression": "I.rms²=(1/T)∫₀ᵀ i²(t)dt", "justification": "RMS 是平方平均的平方根。", "trace": { "kind": "identity", "refs": [], "note": "RMS 定义。" } },
        { "id": "step.rms-linear-wave", "statement": "把导通区间归一化为 x∈[0,1] 的线性电流。", "expression": "i(x)=I.valley+(I.peak-I.valley)x", "justification": "定电感、定电压下 di/dt 为常数。", "trace": { "kind": "identity", "refs": [], "note": "线性插值。" } },
        { "id": "step.rms-integral", "statement": "对线性电流平方积分。", "expression": "∫₀¹i²(x)dx=(I.valley²+I.valley·I.peak+I.peak²)/3", "justification": "展开二次多项式并逐项积分。", "trace": { "kind": "identity", "refs": [], "note": "多项式定积分。" } },
        { "id": "step.rms-duty", "statement": "导通区间只占整周期 D。", "expression": "I.prirms=sqrt{D/3·(I.valley²+I.valley·I.peak+I.peak²)}", "justification": "关断区间原边开关电流为零，平方积分只乘导通占比 D。", "trace": { "kind": "identity", "refs": [], "note": "分段积分合并。" } }
      ],
      "dimensionalCheck": "括号内为 A²，D/3 为无量纲，平方根后为 A。",
      "returnTarget": "ccm-flyback-current-chain-derivation",
      "summary": "该式不是经验系数，而是线性斜坡在导通占比 D 内的平方积分结果。",
      "color": "blue"
    }
