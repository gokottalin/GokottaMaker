  "assumptions": [
    {
      "id": "assumption.vin-low-line",
      "title": "低线一致性场景取 6 V",
      "reason": "项目设计资料存在 6 V 或 9 V 待确认选项；为与既有 DCM/CCM 两册闭合，取更严苛的 6 V。",
      "effect": "占空比、电流纹波、峰谷值和反推反射电压均随输入电压变化；该场景不得代替项目输入规范。",
      "replacement": "用 12 W 与 4.5 W 测试时的准确输入电压替换。",
      "status": "active"
    },
    {
      "id": "assumption.efficiency",
      "title": "一致性场景效率取 75%",
      "reason": "75% 是项目初算 70%-80% 区间中点，并用于保持两功率点的演算一致。",
      "effect": "输入功率、平均电流、峰谷值以及由 BCM 反推的 Vor 都受该假设影响。",
      "replacement": "分别测量 4.5 W 与 12 W 工作点的输入功率和效率。",
      "status": "active"
    },
    {
      "id": "assumption.equal-efficiency",
      "title": "4.5 W 与 12 W 两点效率近似相同",
      "reason": "参考书使用输出功率比解释 CCM 电流位置；若效率不同，应改用输入功率比。",
      "effect": "影响由边界功率推导的电流位置比例，但不改变 12 W 高于同工况 4.5 W 边界这一模式判断。",
      "replacement": "分别测得两工作点效率并改用输入功率比。",
      "status": "active"
    },
    {
      "id": "assumption.primary-turns",
      "title": "等效原边匝数暂按 12 匝解释",
      "reason": "规格书绕制顺序显示两个 6 匝原边分段，但内部串接点尚未由供应商或低压匝比测试确认。",
      "effect": "只影响后续磁通、AL 与绕组映射判断；本参考实例的电流闭合链未使用该数值。",
      "replacement": "供应商确认内部连接或执行低压匝比测试。",
      "status": "active"
    }
  ],
