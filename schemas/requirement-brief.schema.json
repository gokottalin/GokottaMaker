{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.larkix.com/schemas/requirement-brief.schema.json",
  "title": "Larkix confirmed requirement brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requirementId",
    "title",
    "status",
    "priority",
    "createdAt",
    "updatedAt",
    "intent",
    "scope",
    "behavior",
    "acceptanceCriteria",
    "constraints",
    "evidence",
    "openQuestions",
    "assumptions",
    "risks",
    "confirmation",
    "dispatch"
  ],
  "properties": {
    "schemaVersion": {
      "const": "larkix.requirement-brief.v1"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^REQ-[0-9]{8}-[0-9]{3}$"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "status": {
      "enum": [
        "draft",
        "questioning",
        "awaiting_user_confirmation",
        "user_confirmed",
        "dispatched",
        "superseded",
        "cancelled"
      ]
    },
    "priority": {
      "enum": ["low", "normal", "high", "urgent"]
    },
    "createdAt": {
      "$ref": "#/$defs/dateTime"
    },
    "updatedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "desiredOutcome", "targetUsers"],
      "properties": {
        "problem": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "desiredOutcome": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "targetUsers": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in", "out"],
      "properties": {
        "in": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "out": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "expected", "edgeCases"],
      "properties": {
        "current": {
          "$ref": "#/$defs/stringArray"
        },
        "expected": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "edgeCases": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "verification"],
        "properties": {
          "id": {
            "$ref": "#/$defs/localId"
          },
          "statement": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "verification": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages",
        "platforms",
        "compatibility",
        "data",
        "security",
        "operations",
        "deadline"
      ],
      "properties": {
        "languages": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "platforms": {
          "$ref": "#/$defs/stringArray"
        },
        "compatibility": {
          "$ref": "#/$defs/stringArray"
        },
        "data": {
          "$ref": "#/$defs/stringArray"
        },
        "security": {
          "$ref": "#/$defs/stringArray"
        },
        "operations": {
          "$ref": "#/$defs/stringArray"
        },
        "deadline": {
          "type": ["string", "null"]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "locator", "note", "status"],
        "properties": {
          "id": {
            "$ref": "#/$defs/localId"
          },
          "kind": {
            "enum": ["file", "url", "screenshot", "video", "data", "observation"]
          },
          "locator": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "note": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "status": {
            "enum": ["provided", "verified", "unverified"]
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "impact", "status", "answer"],
        "properties": {
          "id": {
            "$ref": "#/$defs/localId"
          },
          "question": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "impact": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "status": {
            "enum": ["open", "resolved", "deferred_to_a00", "out_of_scope"]
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "status"],
        "properties": {
          "id": {
            "$ref": "#/$defs/localId"
          },
          "statement": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "status": {
            "enum": ["proposed", "owner_accepted", "rejected"]
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "statement", "mitigation"],
        "properties": {
          "id": {
            "$ref": "#/$defs/localId"
          },
          "severity": {
            "enum": ["low", "medium", "high", "critical"]
          },
          "statement": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "mitigation": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed",
        "confirmedBy",
        "confirmedAt",
        "confirmationText",
        "digest"
      ],
      "properties": {
        "confirmed": {
          "type": "boolean"
        },
        "confirmedBy": {
          "type": ["string", "null"]
        },
        "confirmedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "confirmationText": {
          "type": ["string", "null"]
        },
        "digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRole",
        "recommendedWorkbenches",
        "dependencies",
        "dispatchedAt"
      ],
      "properties": {
        "targetRole": {
          "const": "A00_ProjectDirector"
        },
        "recommendedWorkbenches": {
          "$ref": "#/$defs/stringArray"
        },
        "dependencies": {
          "$ref": "#/$defs/stringArray"
        },
        "dispatchedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["user_confirmed", "dispatched"]
          }
        }
      },
      "then": {
        "properties": {
          "confirmation": {
            "properties": {
              "confirmed": {
                "const": true
              },
              "confirmedBy": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "confirmedAt": {
                "$ref": "#/$defs/dateTime"
              },
              "confirmationText": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "openQuestions": {
            "items": {
              "properties": {
                "status": {
                  "not": {
                    "const": "open"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "dispatched"
          }
        }
      },
      "then": {
        "properties": {
          "dispatch": {
            "properties": {
              "dispatchedAt": {
                "$ref": "#/$defs/dateTime"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,63}$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    }
  }
}
